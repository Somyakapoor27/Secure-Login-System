<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Set Up Two-Factor Authentication</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <div class="card wide">
    <h1>Set up 2FA</h1>
    <p class="subtitle">Scan this QR code with Google Authenticator, Authy, or a similar app.</p>

    <% if (errors && errors.length) { %>
      <div class="errors">
        <ul>
          <% errors.forEach(function(e) { %>
            <li><%= e.msg %></li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <div class="qr-box">
      <img src="<%= qrDataUrl %>" alt="2FA QR Code" width="220" height="220" />
    </div>

    <p class="subtitle" style="margin-bottom:4px;">Or enter this code manually:</p>
    <span class="secret-code"><%= secret %></span>

    <form method="POST" action="/2fa/setup" novalidate>
      <label for="token">Enter the 6-digit code from your app to confirm</label>
      <input type="text" id="token" name="token" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required autofocus />
      <button type="submit">Confirm & Enable 2FA</button>
    </form>

    <div class="link-row">
      <a href="/dashboard">Cancel</a>
    </div>
  </div>
</body>
</html>
